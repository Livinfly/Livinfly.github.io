{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {{- range .Data.Pages }}
        {{- if not .Sitemap.Disable }}
            {{- $lastmod := .Lastmod -}}
            {{- if .IsHome -}}
                {{- with site.GetPage "/academic/home/en" -}}
                    {{- $lastmod = .Lastmod -}}
                {{- else -}}
                    {{- errorf "English academic homepage was not found while building sitemap" -}}
                {{- end -}}
            {{- else if eq .RelPermalink "/life-blog/" -}}
                {{- $lifePages := where site.RegularPages "Type" "in" site.Params.mainSections -}}
                {{- $lifePages = where $lifePages "Params.hidden" "!=" true -}}
                {{- if gt (len $lifePages) 0 -}}
                    {{- $lastmod = (index $lifePages.ByLastmod.Reverse 0).Lastmod -}}
                {{- end -}}
            {{- else if eq .RelPermalink "/acad-blog/" -}}
                {{- $posts := partial "academic/blog-items.html" "en" -}}
                {{- if gt (len $posts) 0 -}}
                    {{- $lastmod = (index $posts.ByLastmod.Reverse 0).Lastmod -}}
                {{- end -}}
            {{- else if eq .RelPermalink "/zh-cn/acad-blog/" -}}
                {{- $posts := partial "academic/blog-items.html" "zh-cn" -}}
                {{- if gt (len $posts) 0 -}}
                    {{- $lastmod = (index $posts.ByLastmod.Reverse 0).Lastmod -}}
                {{- end -}}
            {{- end }}
    <url>
        <loc>{{ .Permalink }}</loc>
            {{- if not $lastmod.IsZero }}
        <lastmod>{{ $lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
            {{- end }}
            {{- with .Sitemap.ChangeFreq }}
        <changefreq>{{ . }}</changefreq>
            {{- end }}
            {{- if ge .Sitemap.Priority 0.0 }}
        <priority>{{ .Sitemap.Priority }}</priority>
            {{- end }}
    </url>
        {{- end }}
    {{- end }}
</urlset>
